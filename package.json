{
  "name": "romulator",
  "version": "0.0.0",
  "description": "A rom management system that can integrate your library with other platforms.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/romulator"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/stats'",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "janitor-lint",
    "build": "lerna run build",
    "make": "yarn clean && yarn check && yarn lint && yarn test && yarn build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@zthun/janitor-build-config": "^19.3.6",
    "@zthun/janitor-lint": "^19.3.6",
    "@zthun/janitor-lint-config": "^19.3.6",
    "happy-dom": "^20.0.0",
    "husky": "^9.1.7",
    "lerna": "^9.0.0",
    "lodash-es": "^4.17.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "rollup": "npm:@rollup/wasm-node@*"
  },
  "packageManager": "yarn@4.10.3"
}
