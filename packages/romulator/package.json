    "helmet": "^8.1.0",
    "lodash-es": "^4.17.21",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.2",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
