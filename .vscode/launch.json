{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run @zthun/romulator-api",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/romulator-api/src/main.mts",
      "runtimeExecutable": "tsx",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to @zthun/romulator-api",
      "port": 9229,
      "address": "0.0.0.0",
      "remoteRoot": "/usr/dev",
      "localRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "/usr/dev/*": "${workspaceRoot}/*"
      }
    }
  ]
}
